    {
      "type": "text", "id": "env-l", "x": 74, "y": 452, "width": 822, "height": 86,
      "text": "quadlet maps each podman secret → container env (type=env) / mount (type=mount):\n  pr-agent-deepseek-key → OPENAI__KEY      pr-agent-github-app-key → GITHUB_APP__PRIVATE_KEY (multi-line PEM)\n  pr-agent-github-app-id → GITHUB_APP__APP_ID      pr-agent-webhook-secret → GITHUB__WEBHOOK_SECRET\n  pr-agent-tunnel-cred → mount /etc/cloudflared/cred.json",
      "originalText": "quadlet maps each podman secret → container env (type=env) / mount (type=mount):\n  pr-agent-deepseek-key → OPENAI__KEY      pr-agent-github-app-key → GITHUB_APP__PRIVATE_KEY (multi-line PEM)\n  pr-agent-github-app-id → GITHUB_APP__APP_ID      pr-agent-webhook-secret → GITHUB__WEBHOOK_SECRET\n  pr-agent-tunnel-cred → mount /etc/cloudflared/cred.json",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#7ee787", "backgroundColor": "transparent", "fillStyle": "solid",
