# Copy to broker-secrets.vars (git-ignored) and fill, then run:
#   bash deploy/set-broker-secrets.sh        # after `wrangler deploy` of the broker
# Single-quote the inline values so the shell does not mangle them. The tunnel
# cred and PEM are file paths (never inlined), so their JSON/newlines stay intact.
DEEPSEEK_API_KEY='sk-...'
GITHUB_APP_ID=1234567
GITHUB_WEBHOOK_SECRET='...'
TUNNEL_CRED_FILE=~/.cloudflared/<TUNNEL_UUID>.json
GITHUB_APP_PRIVATE_KEY_FILE=~/Downloads/pr-agent.<date>.private-key.pem
