[Unit]
Description=PR-Agent webhook server
After=network-online.target

[Container]
ContainerName=pr-agent
Image=localhost/pr-agent:current
Pod=pragent.pod
Environment=OPENAI__API_BASE=https://api.deepseek.com
Environment=CONFIG__MODEL=deepseek-v4-pro
# deepseek-v4-pro: 1M context window (output ceiling 384K is handled by PR-Agent's output-budget settings).
Environment=CONFIG__CUSTOM_MODEL_MAX_TOKENS=1000000
Environment=CONFIG__FALLBACK_MODELS=["deepseek-v4-flash"]
Environment=GITHUB__DEPLOYMENT_TYPE=app
# Auto-run review tools on draft PRs too (patches/apply.sh implements this setting,
# which upstream documents but ships unwired).
Environment=GITHUB_APP__FEEDBACK_ON_DRAFT_PR=true
Secret=pr-agent-deepseek-key,type=env,target=OPENAI__KEY
Secret=pr-agent-github-app-key,type=env,target=GITHUB__PRIVATE_KEY
Secret=pr-agent-github-app-id,type=env,target=GITHUB__APP_ID
Secret=pr-agent-webhook-secret,type=env,target=GITHUB__WEBHOOK_SECRET

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
