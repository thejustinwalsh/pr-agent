# deploy/config.env — shared constants for the PR-Agent deployment.
# Public fork + PUBLIC ghcr image → server pulls anonymously (no registry token).
GHCR_OWNER=thejustinwalsh
FORK_REPO=thejustinwalsh/pr-agent
UPSTREAM_REPO=The-PR-Agent/pr-agent
IMAGE=ghcr.io/thejustinwalsh/pr-agent
APP_DOMAIN=pr-agent.tjw.dev
# Shared secrets broker (secrets.tjw.dev), path-scoped per project. This box reads
# its bundle from https://$SECRETS_DOMAIN/secrets/$SECRETS_NS (see fetch-secrets.sh).
SECRETS_DOMAIN=secrets.tjw.dev
SECRETS_NS=pr-agent
POD_NAME=pr-agent
DEPLOY_USER=pragent
DATA_MOUNT=/var/lib/pr-agent           # state dir for deploy-state only (PR-Agent itself is stateless; no volume)
WEBHOOK_PORT=3000
# Tunnel UUID for the locally-configured cloudflared ingress (not secret; fill at setup).
TUNNEL_ID=REPLACE_WITH_TUNNEL_UUID
# DeepSeek model (reasoning; better reviews). Fallback: deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_BASE=https://api.deepseek.com
# Podman secret names (created by fetch-secrets.sh, consumed by quadlet as env targets):
SECRET_DEEPSEEK=pr-agent-deepseek-key
SECRET_GH_APP_KEY=pr-agent-github-app-key
SECRET_GH_APP_ID=pr-agent-github-app-id
SECRET_WEBHOOK=pr-agent-webhook-secret
SECRET_TUNNEL=pr-agent-tunnel-cred
