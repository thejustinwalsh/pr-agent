# Copy to cloud-init.vars (git-ignored) and fill. Then: ./gen-cloud-init.sh cloud-init.vars
CF_SERVICE_TOKEN_ID=
CF_SERVICE_TOKEN_SECRET=
FORK_REPO=thejustinwalsh/pr-agent
TUNNEL_ID=
# Secrets namespace served by the broker (path /secrets/<ns>). Optional — defaults
# to pr-agent. (No OTP_KV_ID needed: gen-cloud-init reads it from wrangler.toml.)
SECRETS_NS=pr-agent
